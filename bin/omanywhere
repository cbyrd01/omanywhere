#!/bin/bash
# omanywhere: run stock Omarchy as a container desktop, reached with gliff over
# ssh. See docs/usage.md.
#
#   omanywhere up NAME [--gpu auto|none|nvidia|dri|dri:/dev/dri/cardN|vkms]
#                      [--key FILE | --github USER [--yes]] [--listen ADDR]
#                      [--drm-master allow] [--password | --no-password]
#   omanywhere down NAME [--purge [--yes]]
#   omanywhere ssh-config NAME
#   omanywhere status NAME
#
# NAME's container is omanywhere-NAME, with the named volumes
# omanywhere-NAME-home (/home) and omanywhere-NAME-state (/var/lib/omanywhere).
# Its keys and settings, and its password if it has one (up --password), are
# kept in OMANYWHERE_CONFIG_DIR/NAME
# (default ~/.config/omanywhere/NAME, mode 0700). OMANYWHERE_IMAGE is the image
# (default omanywhere:dev, built by make image); it is never pulled.
set -euo pipefail

image=${OMANYWHERE_IMAGE:-omanywhere:dev}
config_root=${OMANYWHERE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/omanywhere}
# The owner account's default name (OMANYWHERE_USER in the container).
user=omarchy
# The host's DRM nodes and their sysfs (plain variables, so tests/cli.sh can
# point them at a made-up tree).
dev_dri=/dev/dri
drm_class=/sys/class/drm
# Where the kernel puts configfs vkms cards (omanywhere-host vkms add NAME).
faux=/sys/devices/faux

# The run flags, shared with the tests; docs/usage.md ("The run flags") says
# what each is for. Found beside this script, through any symlink to it.
# shellcheck source=lib/run-flags.bash
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/run-flags.bash"

usage() {
  cat >&2 <<'EOF'
usage: omanywhere up NAME [--gpu auto|none|nvidia|dri|dri:/dev/dri/cardN|vkms]
                     [--key FILE | --github USER [--yes]] [--listen ADDR] [--drm-master allow]
                     [--password | --no-password] [--data DIR]
       omanywhere down NAME [--purge [--yes]]
       omanywhere ssh-config NAME
       omanywhere status NAME
See docs/usage.md.
EOF
  exit 2
}

say() {
  echo "omanywhere: $*" >&2
}

die() {
  say "$*"
  exit 1
}

# set_name NAME: check NAME and set the names derived from it. Lower-case
# letters, digits and inner hyphens, up to 32 characters, so every derived
# name is a valid container, volume and hostname, and a path component.
set_name() {
  [[ ${1:-} =~ ^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$ ]] ||
    die "'${1:-}' is not a valid name: use 1 to 32 lower-case letters, digits and inner hyphens"
  name=$1
  container=omanywhere-$name
  home_volume=$container-home
  state_volume=$container-state
  config=$config_root/$name
  settings=$config/settings
}

# --- Settings kept in $config/settings, one key=value per line: what the
# first up chose, which later ups reuse.
listen='' port='' gpu='' drm_master='' old_sudo=''

# check KEY VALUE WHERE: VALUE is valid for the setting KEY, or die saying
# what WHERE (an option, or the settings file) takes. The options and the
# settings file are checked alike.
check() {
  case $1 in
    # That the card exists is checked when the container is made (gpu_args),
    # so status and ssh-config still work once it has gone.
    gpu) [[ $2 =~ ^(auto|none|nvidia|dri|dri:/dev/dri/card[0-9]+|vkms)$ ]] ||
      die "$3 '$2': takes auto, none, nvidia, dri, dri:/dev/dri/cardN or vkms" ;;
    # An IPv4 or IPv6 address, as docker run -p takes it.
    listen) [[ $2 =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ || ($2 =~ ^[0-9A-Fa-f:.]+$ && $2 == *:*) ]] ||
      die "$3 '$2': takes an IPv4 or IPv6 address, such as 127.0.0.1 or a tailnet address" ;;
    drm_master) [[ $2 == allow ]] || die "$3 '$2': takes allow" ;;
    # Docker's volume options split on commas. Not /: its home is the host's.
    data) [[ $2 == /?* && $2 != *[,$'\n']* ]] || die "$3 '$2': takes a directory other than /, whose path has no comma" ;;
    port) [[ $2 =~ ^[1-9][0-9]{0,4}$ && $2 -le 65535 ]] || die "$3 '$2': takes a TCP port" ;;
    # GitHub's rule: letters, digits and single inner hyphens, up to 39
    # characters. It also keeps the URL's path to one component.
    github) [[ $2 =~ ^[A-Za-z0-9]([A-Za-z0-9]|-[A-Za-z0-9]){0,38}$ ]] ||
      die "$3 '$2': takes a GitHub user name, such as octocat" ;;
  esac
}

load_settings() {
  local key value
  [[ -f $settings ]] || return 1
  while IFS='=' read -r key value; do
    case $key in
      listen | port | gpu | drm_master)
        [[ -z $value ]] || check "$key" "$value" "$settings: $key"
        printf -v "$key" '%s' "$value"
        ;;
      # An older omanywhere's --sudo, gone: a password now decides (up says so).
      sudo) [[ $value != nopasswd ]] || old_sudo=1 ;;
      # Other keys are ignored.
    esac
  done <"$settings"
}

save_settings() {
  printf '%s\n' "listen=$listen" "port=$port" "gpu=$gpu" "drm_master=$drm_master" >"$settings.new"
  mv "$settings.new" "$settings"
}

# --- Docker.

# volume_dir VOLUME: the host directory the volume keeps its files in, made
# by up --data; empty for one in Docker's own store. Fails if there's none.
# Docker keeps it with the volume, so the settings don't.
volume_dir() {
  docker volume inspect -f '{{index .Options "device"}}' "$1" 2>/dev/null
}

# check_volumes: the volumes that exist already keep their files where they
# are: up never moves them, and data takes their directory. It sets missing
# to the volumes (home, state) that make_volumes makes. Each desktop has its
# own DIR/NAME, so two never share a home and host key.
check_volumes() {
  local sub have given=$data absent=()
  for sub in home state; do
    if ! have=$(volume_dir "$container-$sub"); then
      absent+=("$sub")
    elif [[ -z $have ]]; then
      [[ -z $given ]] ||
        die "$container-$sub is in Docker's own volume store, not $given/$name/$sub, and up doesn't move a desktop's files: --data applies to new volumes (down $name --purge removes these)"
    else
      [[ $have == /*/"$name/$sub" ]] ||
        die "$container-$sub keeps its files in $have, not in a DIR/$name/$sub, and up doesn't move them: move them there and remove the volumes (down $name --purge), then up $name --data DIR"
      [[ -z $given || $have == "$given/$name/$sub" ]] ||
        die "$container-$sub keeps its files in $have, not $given/$name/$sub, and up doesn't move them: pass --data ${have%/*/*}, or leave it out"
      [[ -d $have ]] ||
        die "$container-$sub keeps its files in $have, which is gone: put them back there, or remove the volumes (down $name --purge)"
      data=${have%/*/*}
    fi
  done
  missing=()
  [[ -n $data ]] || return 0
  missing=("${absent[@]}")
  ((${#missing[@]})) || return 0
  for sub in "" /home /state; do
    [[ ! -L $data/$name$sub ]] || die "$data/$name$sub is a symlink, which Docker would follow: --data makes its directories itself"
  done
}

# make_volumes: with --data, the missing volumes, in DIR/NAME/home and
# DIR/NAME/state.
# Docker fills an empty one from the image, as it does a volume in its own
# store, and uses a directory with files as it is.
make_volumes() {
  local sub
  for sub in "${missing[@]}"; do
    (umask 077 && mkdir -p -- "$data/$name/$sub") || die "could not make $data/$name/$sub"
    docker volume create --opt type=none --opt o=bind --opt "device=$data/$name/$sub" "$container-$sub" >/dev/null ||
      die "could not make the volume $container-$sub in $data/$name/$sub"
  done
}

container_state() {
  local state
  # A missing container prints an empty line as well as the error.
  if state=$(docker container inspect -f '{{.State.Status}}' "$container" 2>/dev/null); then
    echo "$state"
  else
    echo absent
  fi
}

# cexec CMD...: CMD as root in the container.
cexec() {
  docker exec "$container" "$@"
}

# cdi_gpu: Docker sees NVIDIA's CDI device nvidia.com/gpu=all (it lists the
# devices it discovered from the CDI spec directories, /etc/cdi and
# /var/run/cdi, without root).
cdi_gpu() {
  docker info --format '{{range .DiscoveredDevices}}{{.ID}}{{"\n"}}{{end}}' 2>/dev/null |
    grep -x 'nvidia.com/gpu=all' >/dev/null
}

# card_render CARD: the host's render node (/dev/dri/renderDN) on the same
# device as the DRM card CARD (cardN), from sysfs; nothing if it has none
# (vkms).
card_render() {
  local sys
  for sys in "$drm_class/$1/device/drm/renderD"*; do
    [[ -e $sys && -c $dev_dri/${sys##*/} ]] || continue
    echo "/dev/dri/${sys##*/}"
    return
  done
}

# vkms_card: the host's DRM card (cardN) for this container's vkms card,
# omanywhere-NAME; fails if there is none.
vkms_card() {
  local sys
  for sys in "$faux/$container/drm/card"*; do
    [[ $sys =~ /card[0-9]+$ && -c $dev_dri/${sys##*/} ]] || continue
    echo "${sys##*/}"
    return 0
  done
  return 1
}

# remake_if_card_moved: for an existing --gpu vkms container. Its devices are
# fixed when it's made, but its card's number can change at a reboot, when the
# host makes the cards again. If it has, cmd_up makes it again (state=absent,
# remake=1) from the same image, with the same volumes, keys, password and
# saved settings, removing the old one only once every check has passed.
remake_if_card_moved() {
  local card info made_from mounted devs
  card=$(vkms_card) || die "this host has no vkms card for $container: run sudo omanywhere-host vkms add $name"
  info=$(docker container inspect -f '{{.Image}}{{"\n"}}{{range .Mounts}}{{if eq .Destination "/run/secrets/password"}}y{{end}}{{end}}{{"\n"}}{{range .HostConfig.Devices}}{{.PathOnHost}} {{end}}' "$container") ||
    die "could not inspect $container"
  { read -r made_from; read -r mounted; read -r devs; } <<<"$info"
  [[ " $devs" != *" /dev/dri/$card "* ]] || return 0
  [[ -z $mounted ]] || has_password ||
    die "$container was made with a password, and $config/password is gone or blank: write it back, or omanywhere down $name, then up"
  say "$container's vkms card is now /dev/dri/$card, not ${devs% }: making it again from the same image, with the same volumes and settings (its root is reset, as with down and up)"
  image=$made_from state=absent remake=1 opt_gpu='' opt_listen='' opt_master='' opt_password='' opt_data=''
}

# warn_nvidia CARD...: one warning if any of the cards (cardN) that --gpu dri
# passes is NVIDIA's. The desktop session can't use such a card through
# /dev/dri alone: NVIDIA's GBM backend, which Hyprland allocates through,
# comes only with the CDI spec (see classify in /usr/lib/omanywhere/session).
warn_nvidia() {
  local card driver nvidia=()
  for card; do
    driver=$(readlink -f "$drm_class/$card/device/driver" 2>/dev/null) || driver=
    [[ ${driver##*/} != nvidia ]] || nvidia+=("/dev/dri/$card")
  done
  ((${#nvidia[@]})) || return 0
  local fix="Install nvidia-container-toolkit and use --gpu nvidia (see docs/usage.md)"
  ! cdi_gpu || fix="Docker has its CDI device: use --gpu nvidia (or auto)"
  say "warning: ${nvidia[*]} is an NVIDIA card, which the desktop can't use through /dev/dri alone, as NVIDIA's GBM backend comes only through CDI (nvidia.com/gpu=all). $fix"
}

# gpu_args MODE: set devices (docker run arguments) and gpu_note for --gpu MODE.
gpu_args() {
  local node card render cards=()
  devices=()
  for node in "$dev_dri"/card*; do
    [[ -c $node ]] || continue
    cards+=("${node##*/}")
  done
  case $1 in
    none) gpu_note="no device: the desktop will be skipped (it needs a DRM card)" ;;
    nvidia)
      cdi_gpu || die "--gpu nvidia: Docker sees no CDI device nvidia.com/gpu=all (install nvidia-container-toolkit; see docs/usage.md)"
      devices=(--device nvidia.com/gpu=all)
      gpu_note="NVIDIA GPU through CDI (nvidia.com/gpu=all)"
      ;;
    dri)
      ((${#cards[@]})) || die "--gpu dri: this host has no /dev/dri/card*"
      warn_nvidia "${cards[@]}"
      devices=(--device /dev/dri)
      gpu_note="/dev/dri (${cards[*]})"
      ;;
    # One card, and its own render node: each container on a CPU-only host
    # needs a vkms card of its own (the desktop must be its DRM master, and a
    # card has one).
    dri:*)
      card=${1#dri:/dev/dri/}
      [[ -c $dev_dri/$card ]] || die "--gpu $1: this host has no character device /dev/dri/$card"
      warn_nvidia "$card"
      render=$(card_render "$card")
      devices=(--device "/dev/dri/$card" ${render:+--device "$render"})
      gpu_note="/dev/dri/$card${render:+ and its render node $render}"
      ;;
    # The container's own vkms card, found by its name, since its number can
    # change from one boot to the next (omanywhere-host vkms add NAME).
    vkms)
      card=$(vkms_card) || die "--gpu vkms: this host has no vkms card for $container: run sudo omanywhere-host vkms add $name (docs/usage.md, Setting up a host)"
      devices=(--device "/dev/dri/$card")
      gpu_note="its vkms card omanywhere-$name (/dev/dri/$card)"
      ;;
    auto)
      if cdi_gpu; then
        gpu_args nvidia
      elif ((${#cards[@]})); then
        gpu_args dri
      else
        devices=()
        gpu_note="no device: no CDI GPU and no /dev/dri/card* on this host, so the desktop will be skipped (it needs a DRM card: a GPU, or vkms on a CPU-only host; see docs/usage.md)"
      fi
      ;;
  esac
}

# pick_port BIND: a free port on BIND, as Docker picks one: through a
# throwaway container that publishes it. The real container then publishes
# that port by number. Docker picks an unnamed port (-p BIND::22) again at
# every start (seen with Docker 29: 32768, 32769, 32770 over two restarts),
# and with no restart policy a container starts again after each reboot, so
# ssh's address would keep changing.
# The throwaway is named for this run alone, so one left by an interrupted
# up can't get in the way, and holds no privilege (it only sleeps).
pick_port() {
  local probe=$container-port-$$-$RANDOM out
  out=$(docker run -d --rm --pull never --name "$probe" --cap-drop ALL --security-opt no-new-privileges \
    -p "$1::22" --entrypoint sleep "$image" 60 2>&1) ||
    die "could not have Docker pick a port on $1: $out"
  out=$(docker port "$probe" 22/tcp 2>&1 | head -n 1) || true
  docker rm -f "$probe" >/dev/null 2>&1 || true
  port=${out##*:}
  [[ $port =~ ^[0-9]+$ ]] || die "Docker gave no port on $1: $out"
}

# --- Secrets. The password file is the setting: a container has a password
# when $config/password holds a non-blank line. up --password makes one (or
# keeps the one there, such as one written by hand), --no-password deletes it.
# It is only ever written to a file: never an argument, the container's
# environment, or the terminal.

has_password() {
  grep -q '[^[:space:]]' "$config/password" 2>/dev/null
}

make_password() {
  [[ -s $config/password ]] && return
  # 24 random bytes (192 bits) in base64, less any / and +: about 30 characters.
  (umask 077 && head -c 24 /dev/urandom | base64 | tr -d '\n/+=' >"$config/password")
  [[ -s $config/password ]] || die "could not make a password in $config/password"
}

# has_key TEXT: TEXT has a line that isn't blank or a comment. The
# container's owner unit checks that each such line is a public key (and
# fails, which up reports, if one isn't); this only makes sure there is one.
has_key() {
  grep -Eqv '^[[:space:]]*(#|$)' <<<"$1"
}

# github_keys USER: print the public keys GitHub publishes for USER at
# https://github.com/USER.keys, as ssh-import-id and cloud-init fetch them,
# and say which they are. HTTPS only, redirects included. Whoever holds USER's
# account gets in, and a mistyped USER may be a stranger's, so it asks first,
# as down --purge does: on a terminal, or --yes ($yes) without one.
github_keys() {
  local url=https://github.com/$1.keys keys fingerprints answer
  # head caps a body sent with no Content-Length, which --max-filesize can't.
  keys=$(curl --fail --silent --show-error --location --proto =https --proto-redir =https \
    --max-time 20 --max-filesize 1048576 "$url" | head -c 1048576) || die "--github $1: couldn't fetch $url"
  has_key "$keys" || die "no ssh key for GitHub user $1: $url lists none"
  fingerprints=$(ssh-keygen -l -f /dev/stdin <<<"$keys" 2>&1) ||
    die "--github $1: $url isn't a list of public keys: $fingerprints"
  say "the keys GitHub user $1 publishes ($url):"
  echo "  ${fingerprints//$'\n'/$'\n'  }" >&2
  if [[ -z $yes ]]; then
    [[ -t 0 ]] || die "--github lets whoever holds GitHub user $1 log in; pass --yes to confirm without a terminal"
    read -r -p "Let these keys log in to $container? [y/N] " answer
    [[ $answer == [yY]* ]] || die "not using GitHub user $1's keys"
  fi
  printf '%s\n' "$keys"
}

# new_keys KEYFILE GITHUB_USER: print the keys up should give the container:
# --key KEYFILE's or --github GITHUB_USER's, else nothing if keys kept from an
# earlier up stay, else (with a password: nothing, a password-only desktop, and
# the agent's keys are not taken) the ssh agent's. Fails, saying so, when there
# is none and no password. Keys kept from an earlier up stay until you delete
# $config/authorized_keys.
new_keys() {
  local keyfile=$1 github=$2 keys
  if [[ -n $keyfile ]]; then
    [[ -r $keyfile ]] || die "--key $keyfile: can't read it"
    keys=$(<"$keyfile")
    has_key "$keys" || die "no ssh key in $keyfile: it has no public key line"
  elif [[ -n $github ]]; then
    keys=$(github_keys "$github") || exit 1
  elif [[ -f $config/authorized_keys ]] && has_key "$(<"$config/authorized_keys")"; then
    return
  elif [[ -n $password ]]; then
    say "no ssh key: ssh will take the password in $config/password (up --key FILE or --github USER adds a key, and then ssh takes keys only)"
    return
  # A locked agent (1Password's, say) can wait for approval: don't wait long.
  elif keys=$(timeout 10 ssh-add -L 2>/dev/null) && has_key "$keys"; then
    say "using the keys in your ssh agent (ssh-add -L)"
  else
    die "no ssh key and no password: pass --key FILE (a public key, such as ~/.ssh/id_ed25519.pub) or --github USER, or add a key to your ssh agent (ssh-add -L lists none), or pass --password to log in with a password instead. ssh is the only way in."
  fi
  printf '%s\n' "$keys"
}

# write_keys KEYS: KEYS (if any) to $config/authorized_keys, which exists
# afterwards, empty with no key at all (the container always mounts it).
# Rewritten in place: an existing container has the file bind-mounted, and a
# new file (a rename) wouldn't reach it.
write_keys() {
  if [[ -n $1 ]]; then
    (umask 077 && printf '%s\n' "$1" >"$config/authorized_keys")
  elif [[ ! -e $config/authorized_keys ]]; then
    (umask 077 && : >"$config/authorized_keys")
  fi
}

# --- Waiting for, and reporting on, the container's systemd. tests/lib.sh
# has its own wait_running and wait_settled: the CLI doesn't source the
# tests' helpers.

# wait_booted TIMEOUT: wait until systemd has finished booting (running or
# degraded, or anything but starting); print its state.
wait_booted() {
  local deadline=$((SECONDS + $1)) state=
  while ((SECONDS < deadline)); do
    [[ $(container_state) == running ]] || {
      say "the container stopped while it booted; its last output:"
      docker logs --tail 30 "$container" >&2 || true
      return 1
    }
    # --wait blocks until the boot is done, but needs systemd's bus, which
    # isn't up the moment the container starts.
    state=$(timeout $((deadline - SECONDS + 1)) docker exec "$container" systemctl is-system-running --wait 2>/dev/null) || true
    [[ -n $state && $state != offline && $state != unknown && $state != starting ]] && {
      echo "$state"
      return
    }
    sleep 0.5
  done
  say "systemd did not finish booting in $1 s (last state: ${state:-none})"
  return 1
}

# wait_settled TIMEOUT: wait until systemd's job queue has stayed empty for
# 2 s: the desktop session may restart once or twice after the boot.
wait_settled() {
  # shellcheck disable=SC2016 # the script runs, and expands, in the container
  cexec timeout "$1" bash -c '
    quiet=0
    while ((quiet < 4)); do
      if [[ -z $(systemctl list-jobs --no-legend) ]]; then ((++quiet)); else quiet=0; fi
      sleep 0.5
    done' >/dev/null 2>&1
}

# unit_state UNIT: "ActiveState Result".
unit_state() {
  cexec systemctl show -P ActiveState,Result "$1" 2>/dev/null | paste -sd ' '
}

# session_said: the desktop session's last message this boot.
session_said() {
  cexec journalctl -b -u omanywhere-session.service -o cat --no-pager 2>/dev/null |
    grep '^omanywhere-session: ' | tail -n 1 | sed 's/^omanywhere-session: //'
}

# owner_line: the owner unit, for status; with the owner's name when it's up.
owner_line() {
  local state
  state=$(unit_state omanywhere-owner.service)
  case $state in
    "active success") echo "active ($(cexec cat /run/omanywhere/owner 2>/dev/null || echo "?"))" ;;
    *) echo "${state:-unknown}" ;;
  esac
}

# desktop_line: the desktop session, for status: running (on which card),
# skipped (with the session's reason: no card, or a refused DRM master),
# or another state with its last message.
desktop_line() {
  local state card
  state=$(unit_state omanywhere-session.service)
  case $state in
    "active "*)
      card=$(cexec cat /run/omanywhere/session.env 2>/dev/null |
        sed -n 's/^OMANYWHERE_CARD=//p; s/^OMANYWHERE_CARD_KIND=/, /p; s/^OMANYWHERE_CARD_DRIVER=/, /p' | paste -sd '')
      echo "running on ${card:-?}; $(cexec cat /run/omanywhere/sshd/gliff.conf 2>/dev/null | sed -n 's/^SetEnv //p')"
      ;;
    "inactive exec-condition") echo "skipped: $(session_said)" ;;
    *) echo "${state:-unknown}: $(session_said)" ;;
  esac
}

# health_line: Docker's health of the container (the image's HEALTHCHECK),
# with the check's last message when it isn't healthy; empty for a container
# made from an older image without one.
health_line() {
  local out health said
  out=$(docker container inspect -f '{{with .State.Health}}{{.Status}}{{"\n"}}{{range .Log}}{{.Output}}{{end}}{{end}}' "$container" 2>/dev/null) || return 0
  health=${out%%$'\n'*}
  [[ -n $health ]] || return 0
  [[ $health == healthy ]] || said=$(sed '1d; /^$/d' <<<"$out" | tail -n 1)
  echo "$health${said:+: $said}"
}

endpoint() {
  if [[ $listen == *:* ]]; then echo "[$listen]:$port"; else echo "$listen:$port"; fi
}

# --- Commands.

cmd_up() {
  local keyfile='' github='' yes='' opt_gpu='' opt_listen='' opt_master='' opt_password='' opt_data='' data='' state keys password='' remake='' missing=()
  set_name "${1:-}"
  shift
  while (($#)); do
    case $1 in
      --gpu)
        check gpu "${2:-}" --gpu
        opt_gpu=$2
        ;;
      --key)
        [[ -n ${2:-} ]] || die "--key takes a public key file"
        keyfile=$2
        ;;
      --github)
        check github "${2:-}" --github
        github=$2
        ;;
      --yes)
        yes=1
        shift
        continue
        ;;
      --listen)
        check listen "${2:-}" --listen
        opt_listen=$2
        ;;
      --drm-master)
        check drm_master "${2:-}" --drm-master
        opt_master=$2
        ;;
      --password)
        opt_password=yes
        shift
        continue
        ;;
      --no-password)
        opt_password=no
        shift
        continue
        ;;
      --data)
        [[ -n ${2:-} ]] || die "--data takes a directory"
        opt_data=$(realpath -m -- "$2")
        check data "$opt_data" --data
        ;;
      *) usage ;;
    esac
    shift 2
  done
  [[ -z $keyfile || -z $github ]] || die "--key and --github both give the keys: pass one"
  [[ -z $yes || -n $github ]] || die "--yes confirms --github's keys: pass it with --github"
  docker image inspect "$image" >/dev/null 2>&1 || die "image $image not found: build it with make image"

  state=$(container_state)
  [[ $state == absent || -z $opt_gpu$opt_listen$opt_master$opt_password$opt_data ]] ||
    say "ignoring --gpu, --listen, --drm-master, --password, --no-password and --data: $container exists, and they apply when it's made (omanywhere down $name, then up)"
  if [[ $state == running ]]; then
    if [[ -n $keyfile$github ]]; then
      keys=$(new_keys "$keyfile" "$github") || exit 1
      write_keys "$keys"
      say "wrote the keys to $config/authorized_keys; they apply when $container next starts"
    fi
    say "$container is already running"
    return
  fi

  # Everything is checked before anything is made: the device, then the keys.
  load_settings || true
  [[ $state == absent || $gpu != vkms ]] || remake_if_card_moved
  if [[ $state == absent ]]; then
    gpu=${opt_gpu:-${gpu:-auto}}
    listen=${opt_listen:-${listen:-127.0.0.1}}
    drm_master=${opt_master:-$drm_master}
    data=$opt_data
    gpu_args "$gpu"
    check_volumes
    if [[ -e $config/password && $opt_password != no ]]; then
      has_password || die "$config/password is blank: write a password in it, or delete it, or pass --no-password"
      [[ $(<"$config/password") != *$'\n'* ]] ||
        die "$config/password has more than one line: the password is its one line"
    fi
    if [[ $opt_password == yes ]] || { [[ $opt_password != no ]] && has_password; }; then password=yes; fi
    [[ -z $old_sudo || -n $opt_password ]] ||
      say "$settings has sudo=nopasswd from an older omanywhere, which no longer applies: a container with a password asks for it (up $name --no-password deletes $config/password, and then sudo asks for none)"
  else
    # An existing container keeps what it was made with: a password if it
    # mounts one, which must still be there to start it.
    opt_password=''
    local mounted
    mounted=$(docker container inspect -f '{{range .Mounts}}{{if eq .Destination "/run/secrets/password"}}y{{end}}{{end}}' "$container") ||
      die "could not inspect $container"
    [[ -z $mounted ]] || password=yes
    [[ -z $password ]] || has_password ||
      die "$container was made with a password, and $config/password is gone or blank: write it back, or omanywhere down $name, then up"
  fi
  keys=$(new_keys "$keyfile" "$github") || exit 1
  (umask 077 && mkdir -p "$config")
  write_keys "$keys"
  [[ -z $opt_password || -z $password ]] || make_password
  if [[ -n $password && -n $listen && $listen != 127.* && $listen != ::1 ]] && ! has_key "$(<"$config/authorized_keys")"; then
    say "warning: no ssh key, so ssh on $listen takes only the password; anyone who can reach that address can guess it. Add a key (up $name --key FILE) or listen on 127.0.0.1"
  fi

  if [[ $state != absent ]]; then
    say "starting $container ($state)"
    docker start "$container" >/dev/null ||
      die "could not start $container; if another program has taken its ssh port, $(endpoint), free it and run up again"
  else
    [[ -z $remake ]] || docker rm "$container" >/dev/null || die "could not remove $container to make it again"
    make_volumes
    say "making $container from $image: $gpu_note"
    local env=() bind out
    [[ -z $drm_master ]] || env+=(-e OMANYWHERE_DRM_MASTER=allow)
    local secrets=()
    [[ -z $password ]] || secrets=(-v "$config/password:/run/secrets/password:ro")
    bind=$listen
    [[ $listen != *:* ]] || bind="[$listen]"
    # The first up picks the port; later ones keep it, so ssh's address
    # stays the same, and fail rather than move it. A port picked just now
    # can be taken before the container publishes it: then pick once more.
    local picked='' try
    for try in 1 2; do
      [[ -n $port ]] || {
        pick_port "$bind"
        picked=1
      }
      out=$(docker run -d --pull never --name "$container" --hostname "$name" \
        "${run_flags[@]}" "${devices[@]}" "${env[@]}" \
        -p "$bind:$port:22" \
        -v "$home_volume:/home" -v "$state_volume:/var/lib/omanywhere" \
        -v "$config/authorized_keys:/run/secrets/authorized_keys:ro" \
        "${secrets[@]}" \
        "$image" 2>&1) && break
      docker rm -f "$container" >/dev/null 2>&1 || true
      if [[ -z $picked ]]; then
        die "could not make $container with ssh on $(endpoint), the port kept from its first up: $out
If another program has taken port $port, free it and run up again, or delete the port line in $settings to take a new one (the ssh-config changes then)."
      fi
      ((try == 1)) || die "could not make $container with ssh on $(endpoint): $out"
      say "could not make $container on the port Docker just picked, $port; picking again"
      port=
    done
    save_settings
    # Only once the container is made, so a failed up keeps the file.
    if [[ $opt_password == no && -e $config/password ]]; then
      rm -f "$config/password"
      say "deleted $config/password: $container has no password"
    fi
  fi

  say "waiting for systemd in $container"
  local system
  system=$(wait_booted 180) || {
    docker stop "$container" >/dev/null 2>&1 || true
    die "$container did not boot, so it is stopped; see docker logs $container"
  }
  wait_settled 60 || say "systemd in $container still has jobs queued after 60 s"

  # No owner or no sshd, no way in: fail loudly, with the unit's journal,
  # and leave the container stopped, not running unreachable.
  # A unit in "reloading" still serves; accept it as well as active.
  local unit
  for unit in omanywhere-owner.service sshd.service; do
    [[ $(unit_state "$unit") != "active "* && $(unit_state "$unit") != "reloading "* ]] || continue
    say "$unit is $(unit_state "$unit"), so there is no way in; its journal:"
    cexec journalctl -b -u "$unit" -o cat --no-pager -n 20 >&2 || true
    docker stop "$container" >/dev/null || true
    die "stopped $container. Fix the input (up $name --key FILE or --github USER for the keys) and run up again, or omanywhere down $name"
  done
  print_status "$system"
  echo
  echo "Connect: omanywhere ssh-config $name >>~/.ssh/config, then gliff --headless $container"
}

cmd_down() {
  local purge='' yes='' state answer out
  set_name "${1:-}"
  shift
  while (($#)); do
    case $1 in
      --purge) purge=1 ;;
      --yes) yes=1 ;;
      *) usage ;;
    esac
    shift
  done
  if [[ -n $purge && -z $yes ]]; then
    local what="$container, the volumes $home_volume and $state_volume (the owner's home and the container's identity), and $config (its keys and settings, and its password if it has one)"
    [[ -t 0 ]] || die "--purge removes $what; pass --yes to confirm without a terminal"
    read -r -p "Remove $what? [y/N] " answer
    [[ $answer =~ ^[Yy]([Ee][Ss])?$ ]] || die "nothing removed"
  fi
  state=$(container_state)
  if [[ $state != absent ]]; then
    # systemd shuts down on the image's STOPSIGNAL; give it time to.
    docker stop -t 30 "$container" >/dev/null
    docker rm "$container" >/dev/null
    say "removed $container"
  else
    say "$container does not exist"
  fi
  if [[ -n $purge ]]; then
    local volume dir kept=() dirs=()
    for volume in "$home_volume" "$state_volume"; do
      dir=$(volume_dir "$volume") || continue
      if out=$(docker volume rm "$volume" 2>&1); then
        [[ -z $dir ]] || dirs+=("$dir")
      else
        say "could not remove the volume $volume: $out"
        kept+=("$volume")
      fi
    done
    # A directory someone named isn't removed for them: they delete it.
    ((${#dirs[@]} == 0)) ||
      say "the removed volumes' files stay in ${dirs[*]} (made with --data); delete them yourself, as root (sudo rm -r), once you don't need them"
    # The config holds the password, if any, for what the volumes keep.
    ((${#kept[@]} == 0)) || die "kept $config, as ${kept[*]} remains; run down $name --purge again once nothing uses it"
    rm -rf -- "$config"
    say "removed the volumes $home_volume and $state_volume, and $config"
  else
    say "kept the volumes $home_volume and $state_volume, and $config"
  fi
}

cmd_ssh_config() {
  set_name "${1:-}"
  (($# == 1)) || usage
  load_settings && [[ -n $port ]] || die "no settings for $name in $config: run omanywhere up $name first"
  local host=$listen
  # A wildcard address is reached through any of this host's addresses.
  [[ $listen != 0.0.0.0 && $listen != :: ]] || host=$(uname -n)
  cat <<EOF
# omanywhere $name: add this to ~/.ssh/config, then: gliff --headless $container
Host $container
  HostName $host
  Port $port
  User $user
  HostKeyAlias $container
EOF
}

# print_status [SYSTEMD]: the container's state, and when it runs, systemd's,
# the owner's, the desktop's and ssh's.
print_status() {
  local state system=${1:-}
  state=$(container_state)
  printf '%-10s %s\n' container "$state"
  load_settings || true
  if [[ $state == running ]]; then
    [[ -n $system ]] || system=$(cexec systemctl is-system-running 2>/dev/null) || true
    printf '%-10s %s\n' systemd "${system:-unknown}" owner "$(owner_line)" desktop "$(desktop_line)"
    local health
    health=$(health_line)
    [[ -z $health ]] || printf '%-10s %s\n' health "$health"
  fi
  [[ -z $port ]] || printf '%-10s %s\n' ssh "$(endpoint) (Host $container: omanywhere ssh-config $name)"
  local dir
  dir=$(volume_dir "$home_volume") && [[ -n $dir ]] &&
    printf '%-10s %s\n' data "$dir and $(volume_dir "$state_volume")"
  return 0
}

cmd_status() {
  set_name "${1:-}"
  (($# == 1)) || usage
  print_status
  [[ $(container_state) != absent ]]
}

# Sourced (by tests/cli.sh), it only defines the functions.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  [[ ${1:-} =~ ^(up|down|ssh-config|status)$ ]] || usage
  cmd=cmd_${1//-/_}
  shift
  "$cmd" "$@"
fi
