# Omanywhere's state volume. The image already has all of this, and Docker
# copies it into a new named volume; these lines cover a volume that starts
# empty, such as a bind-mounted host directory.
d /var/lib/omanywhere 0755 root root -
d /var/lib/omanywhere/ssh 0755 root root -
d /var/lib/omanywhere/ssh/etc 0755 root root -
d /var/lib/omanywhere/ssh/etc/ssh 0755 root root -
# /etc/machine-id is a symlink to this file (image/Containerfile). systemd
# writes the machine-id it makes into it when it finds it empty. When it is
# missing, systemd can only keep the id in memory, and that boot is degraded
# (dbus-broker can't read a machine-id). So a state volume that starts empty
# needs one boot to get this file; give it an empty machine-id file, or use a
# named volume, which Docker fills from the image.
f /var/lib/omanywhere/machine-id 0444 root root -
