#!/bin/bash
# The container's desktop: Omarchy's Hyprland for the owner, started by uwsm
# the way Omarchy's session entry starts it, on the DRM card the container was
# given. omanywhere-session.service runs it in three steps:
#
#   check    ExecCondition, as root. Picks the card and writes the choice to
#            /run/omanywhere/session.env, or skips the session (exit 1) and
#            says why. Hyprland can't run without a card: aquamarine allocates
#            its buffers through a DRM card (KMS) node, even with no screen
#            (upstream draft: notes/upstream/aquamarine-headless-without-kms.md).
#   prepare  ExecStartPre, as root. Writes Hyprland's monitor rules for the
#            card to /run/omanywhere/hypr/container.lua, which
#            /usr/share/omanywhere/hypr/hyprland.lua loads after the owner's
#            config, and how gliff-server should capture and encode on it to
#            /run/omanywhere/sshd/gliff.conf, which sshd includes (see
#            gliff_env); then restarts sshd, if it runs or is starting, to
#            read it (see reload_sshd).
#   start    ExecStart, as the owner, in the logind session PAM opened. Reads
#            the choice and execs uwsm.
#
# The card, by exclusion rather than by vendor:
#   - virtual: vkms, whose connectors belong to the container. They stay on and
#     are the desktop's monitors.
#   - ignored: firmware framebuffers (simpledrm and the like), other faux
#     devices, and any card without KMS (nvidia with nvidia_drm modeset=N).
#   - GPU: any other card with KMS. Its connectors are the host's displays:
#     every one is turned off, at start and whenever one appears, so the
#     container never lights a host display, and a headless output is the
#     desktop's monitor.
# A GPU comes first, then a virtual card.
#
# DRM master. Hyprland opens the card itself (LIBSEAT_BACKEND=noop), and the
# first process to open a card nobody is master of becomes its master. On a
# GPU the host's own display server normally holds master, and Hyprland then
# can't modeset anything. If nothing holds it (the host booted before its
# display manager, someone is at a text console, or the host's user logged
# out), Hyprland would become master and its first modeset would turn the
# host's outputs off. So check refuses a GPU nobody is master of, unless
# OMANYWHERE_DRM_MASTER=allow (for a host with no display of its own; the
# owner script passes it from the container's inputs). vkms is exempt. A
# refused desktop stays down until the container restarts.
#
# Master can change hands after check: plymouth quits before the host's
# display manager starts, a greeter hands over to the user's session, someone
# switches VT. So start checks again just before it execs uwsm, and fails
# (Restart= then runs check again, which skips). What's left is the second or
# so between that check and Hyprland opening the card, which can't be closed
# from here: with LIBSEAT_BACKEND=noop nothing between them holds the card.
# The real fix is a compositor that needs no card to run headless (upstream
# draft: notes/upstream/aquamarine-headless-without-kms.md).
set -euo pipefail

# Where the choice, the monitor rules, sshd's gliff environment, the cards'
# connectors, the render nodes and the nvidia_drm modeset flag live (plain
# variables, so tests/session-logic.sh can point them at a made-up tree).
env_file=/run/omanywhere/session.env
rules=/run/omanywhere/hypr/container.lua
sshd_env=/run/omanywhere/sshd/gliff.conf
dri_dir=/dev/dri
drm_class=/sys/class/drm
nvidia_modeset=/sys/module/nvidia_drm/parameters/modeset

say() {
  echo "omanywhere-session: $*" >&2
}

# card_sysfs NODE: the card's directory in sysfs, found by device number, so a
# node renamed in the container still finds its card.
card_sysfs() {
  readlink -f "/sys/dev/char/$(stat -c '%Hr:%Lr' "$1")"
}

# connectors SYSFS: the card's connectors, named as Hyprland names them
# (/sys/class/drm/card1-DP-1 is DP-1).
connectors() {
  local connector card
  card=$(basename "$1")
  for connector in "$drm_class/$card-"*; do
    [[ -e $connector ]] || continue
    connector=$(basename "$connector")
    echo "${connector#"$card"-}"
  done
}

# classify SYSFS: print the card's kind (virtual, ignored or gpu), its driver,
# and for an ignored card why.
classify() {
  local driver bus
  driver=$(basename "$(readlink -f "$1/device/driver")")
  bus=$(basename "$(readlink -f "$1/device/subsystem")")
  # vkms is a platform driver up to Linux 6.14 and a faux device after, named
  # after its configfs directory when made there; a faux card with connectors
  # can only be a virtual one (vgem has none).
  if [[ $driver == vkms || ($bus == faux && -n $(connectors "$1")) ]]; then
    [[ $bus == faux ]] && driver=$(basename "$(readlink -f "$1/device")")
    echo "virtual $driver"
    return
  fi
  case $driver in
    simple-framebuffer | simpledrm | efidrm | vesadrm | ofdrm | efi-framebuffer | vesa-framebuffer)
      echo "ignored $driver a firmware framebuffer"
      return
      ;;
  esac
  if [[ $bus == faux ]]; then
    echo "ignored $driver a faux device without connectors"
  elif [[ -n $(connectors "$1") ]]; then
    echo "gpu $driver"
  elif [[ $driver == nvidia && $(cat "$nvidia_modeset" 2>/dev/null) == Y ]]; then
    # A GPU with no display outputs (a data-centre card) still has KMS.
    echo "gpu $driver"
  elif [[ $driver == nvidia ]]; then
    echo "ignored $driver no KMS: the host loads nvidia_drm with modeset=N"
  else
    echo "ignored $driver no KMS: the card has no connectors"
  fi
}

# probe_master NODE: print "free" if no one is DRM master of the card, "held"
# if someone is. It opens the card and asks whether this open is master, the
# way libdrm's drmIsMaster does: DRM_IOCTL_AUTH_MAGIC is master-only, so it
# fails with EACCES for anyone else (magic 0 is never valid, so a master gets
# EINVAL instead). An open of a card with no master makes the opener master,
# so for that moment the probe is master. That is harmless: it sets no mode
# and closes the card at once, which drops master. A host display manager
# that starts in that same instant could find master taken and fail its own
# start; the window is the few milliseconds the probe holds the card.
probe_master() {
  python3 -I - "$1" <<'PY'
import errno, fcntl, os, struct, sys

DRM_IOCTL_AUTH_MAGIC = 0x40046411  # _IOW('d', 0x11, struct drm_auth)
fd = os.open(sys.argv[1], os.O_RDWR | os.O_CLOEXEC | os.O_NOCTTY)
try:
    fcntl.ioctl(fd, DRM_IOCTL_AUTH_MAGIC, struct.pack("I", 0))
    print("free")
except OSError as e:
    print("held" if e.errno == errno.EACCES else "free")
finally:
    os.close(fd)
PY
}

# verdict KIND MASTER ALLOW: "use" or "refuse" a card of KIND (gpu or
# virtual) whose DRM master is MASTER (held, free, or n/a for a virtual card),
# given OMANYWHERE_DRM_MASTER=ALLOW.
verdict() {
  local kind=$1 master=$2 allow=$3
  if [[ $kind == virtual || $master == held || $allow == allow ]]; then
    echo use
  else
    echo refuse
  fi
}

# guard_master NODE KIND: exit 1 with the reason if the session must not use
# card NODE of KIND: a GPU nobody is DRM master of, without
# OMANYWHERE_DRM_MASTER=allow.
guard_master() {
  local node=$1 kind=$2 master=n/a
  if [[ $kind == gpu ]]; then
    master=$(probe_master "$node") || {
      say "can't open $node to check its DRM master"
      exit 1
    }
  fi
  if [[ $(verdict "$kind" "$master" "${OMANYWHERE_DRM_MASTER:-}") == refuse ]]; then
    say "no display server holds DRM master on $node; refusing to take it (it would blank the host's outputs). On a host with no display of its own, set OMANYWHERE_DRM_MASTER=allow"
    exit 1
  fi
  [[ $master != free ]] || say "no display server holds DRM master on $node; taking it, as OMANYWHERE_DRM_MASTER=allow says"
}

# render_node SYSFS: the container's node for the card's own render node
# (the one on the same device), found by device number; nothing if the card
# has none (vkms, bochs) or the container wasn't given it.
render_node() {
  local sys node
  for sys in "$1"/device/drm/renderD*; do
    [[ -f $sys/dev ]] || continue
    for node in "$dri_dir"/renderD*; do
      if [[ -c $node && $(stat -L -c '%Hr:%Lr' "$node") == "$(<"$sys/dev")" ]]; then
        echo "$node"
        return
      fi
    done
  done
}

# gliff_env KIND RENDER: how gliff-server captures and encodes the desktop on
# a card of KIND whose own render node is RENDER (empty: none). gliff-server
# reads GLIFF_VIDEO and GLIFF_CAPTURE, and its default, gpu, needs a render
# node it can run Vulkan and VA-API on: without one it errors rather than
# falling back to the CPU as its --help says (gliff 0.4.3; upstream draft:
# notes/upstream/from-spikes.md). With no render node there is no GPU to
# capture dmabufs with either, so Hyprland copies each frame into shared
# memory (shm), which takes gliff's CPU pipeline (OpenH264); that's what the
# CPU-only spike on vkms needed. sshd gives these to every ssh session, so a
# plain `gliff --headless` client needs no flags.
gliff_env() {
  if [[ $1 == gpu && -n $2 ]]; then
    echo "GLIFF_VIDEO=gpu GLIFF_CAPTURE=auto"
  else
    echo "GLIFF_VIDEO=cpu GLIFF_CAPTURE=shm"
  fi
}

# reload_sshd: have sshd read its config again, the gliff environment
# included, if it has read it already. A restart, not a reload: sshd may
# still be starting (activating) now, having read its config before the file
# existed, and systemd drops a try-reload for a unit that isn't active yet,
# but keeps a try-restart's job for an activating one (seen with systemd 262,
# sshd held in start-post: try-reload-or-restart left the same sshd running,
# try-restart started a new one). sshd's KillMode=process keeps the sessions
# already open. A try-restart starts nothing: an sshd that hasn't started
# reads the file when it does. --no-block, so the session never waits on
# sshd.
reload_sshd() {
  systemctl --no-block try-restart sshd.service
}

check() {
  local node sys kind driver why gpu=() virtual=() ignored=()
  # Exit 1 skips the session, so anything unexpected fails it instead.
  set -E
  trap 'say "check failed at line $LINENO"; exit 255' ERR
  rm -f "$env_file" "$sshd_env"
  for node in /dev/dri/card*; do
    [[ -c $node ]] || continue
    sys=$(card_sysfs "$node")
    read -r kind driver why < <(classify "$sys")
    case $kind in
      gpu) ((${#gpu[@]})) || gpu=("$node" "$driver" gpu) ;;
      virtual) ((${#virtual[@]})) || virtual=("$node" "$driver" virtual) ;;
      *) ignored+=("$node ($driver: $why)") ;;
    esac
  done
  if ((${#gpu[@]})); then
    set -- "${gpu[@]}"
  elif ((${#virtual[@]})); then
    set -- "${virtual[@]}"
  elif ((${#ignored[@]})); then
    say "no usable DRM card: ${ignored[*]}; pass a GPU (--device nvidia.com/gpu=all or /dev/dri) or a host vkms card"
    exit 1
  else
    say "no DRM card (/dev/dri/card*) in the container; pass a GPU (--device nvidia.com/gpu=all or /dev/dri) or a host vkms card"
    exit 1
  fi
  node=$1 driver=$2 kind=$3
  ((${#ignored[@]} == 0)) || say "ignoring ${ignored[*]}"

  guard_master "$node" "$kind"

  [[ $node =~ ^/dev/dri/card[0-9]+$ && $driver =~ ^[A-Za-z0-9_.-]+$ ]] || {
    say "unexpected card $node or driver $driver"
    exit 255
  }
  install -D -m 0644 /dev/stdin "$env_file" <<EOF
OMANYWHERE_CARD=$node
OMANYWHERE_CARD_KIND=$kind
OMANYWHERE_CARD_DRIVER=$driver
EOF
}

prepare() {
  local OMANYWHERE_CARD OMANYWHERE_CARD_KIND OMANYWHERE_CARD_DRIVER connector off=()
  # shellcheck source=/dev/null # written by check, as root
  source "$env_file"
  local render gliff
  render=$(render_node "$(card_sysfs "$OMANYWHERE_CARD")")
  gliff=$(gliff_env "$OMANYWHERE_CARD_KIND" "$render")
  # sshd includes what's there, so only root may write to it.
  install -d -m 0755 "${sshd_env%/*}"
  install -m 0644 /dev/stdin "$sshd_env" <<EOF
# Written by /usr/lib/omanywhere/session for this boot's DRM card,
# $OMANYWHERE_CARD ($OMANYWHERE_CARD_KIND, render node: ${render:-none}): how
# gliff-server, started over ssh, captures and encodes the desktop.
# /etc/ssh/sshd_config.d/10-omanywhere.conf includes it.
SetEnv $gliff
EOF
  say "gliff over ssh: $gliff (render node: ${render:-none})"
  reload_sshd || say "could not restart sshd; ssh sessions get the gliff environment once it restarts"
  if [[ $OMANYWHERE_CARD_KIND == virtual ]]; then
    install -D -m 0644 /dev/stdin "$rules" <<EOF
-- Written by /usr/lib/omanywhere/session for this boot's DRM card,
-- $OMANYWHERE_CARD ($OMANYWHERE_CARD_DRIVER), a virtual card: its connectors belong
-- to the container, so they stay on and are the desktop's monitors.
EOF
    say "desktop on $OMANYWHERE_CARD ($OMANYWHERE_CARD_DRIVER), a virtual card; its connectors are the desktop's monitors"
    return
  fi

  while read -r connector; do
    [[ $connector =~ ^[A-Za-z0-9-]+$ ]] || {
      say "unexpected connector name '$connector' on $OMANYWHERE_CARD"
      exit 1
    }
    off+=("\"$connector\"")
  done < <(connectors "$(card_sysfs "$OMANYWHERE_CARD")")
  local IFS=,
  install -D -m 0644 /dev/stdin "$rules" <<EOF
-- Written by /usr/lib/omanywhere/session for this boot's DRM card,
-- $OMANYWHERE_CARD ($OMANYWHERE_CARD_DRIVER), a GPU. Its connectors are the
-- host's displays: all off, and a headless output is the desktop's monitor.

-- The connectors the card has at boot, off from the first frame. A specific
-- output's rule beats Omarchy's output = "" rule in hypr/monitors.lua.
local host_outputs = { ${off[*]} }
for _, name in ipairs(host_outputs) do
  hl.monitor({ output = name, disabled = true })
end

-- A connector the host plugs in later, or a DisplayPort MST stream, is
-- turned off as it appears, and kept off across reloads. That's after its
-- first modeset, so the list above stays the first line of defence. A host
-- output is one of those above, or any name the kernel gives a connector:
-- its type (drm_connector_enum_list in drivers/gpu/drm/drm_connector.c) and
-- a number. Outputs Hyprland makes, HEADLESS-N and gliff's named headless
-- outputs (gliff-N), are never one.
local connector_types = {
  "Unknown", "VGA", "DVI-I", "DVI-D", "DVI-A", "Composite", "SVIDEO", "LVDS",
  "Component", "DIN", "9PinDIN", "DP", "HDMI-A", "HDMI-B", "TV", "eDP",
  "Virtual", "DSI", "DPI", "Writeback", "SPI", "USB",
}
local function host_output(name)
  if name == nil then
    return false
  end
  for _, known in ipairs(host_outputs) do
    if name == known then
      return true
    end
  end
  for _, kind in ipairs(connector_types) do
    if name:sub(1, #kind + 1) == kind .. "-" and name:sub(#kind + 2):match("^%d+$") then
      return true
    end
  end
  return false
end
for _, monitor in ipairs(hl.get_monitors()) do
  if host_output(monitor.name) then
    hl.monitor({ output = monitor.name, disabled = true })
  end
end
hl.on("monitor.added", function(monitor)
  if monitor and host_output(monitor.name) then
    hl.monitor({ output = monitor.name, disabled = true })
  end
end)

-- With them off the desktop has no monitor, so make a headless one at start,
-- before any gliff client connects.
hl.on("hyprland.start", function()
  hl.exec_cmd("hyprctl output create headless")
end)
EOF
  say "desktop on $OMANYWHERE_CARD ($OMANYWHERE_CARD_DRIVER); the host's connectors off: ${off[*]:-none}; a headless output is the desktop's monitor"
}

start() {
  local render OMANYWHERE_CARD OMANYWHERE_CARD_KIND OMANYWHERE_CARD_DRIVER
  ((EUID != 0)) || {
    say "start runs as the owner (the unit's User=), never as root"
    exit 1
  }
  # shellcheck source=/dev/null # written by check, as root
  source "$env_file"
  # aquamarine would otherwise open every card it finds. uwsm passes the
  # environment it starts with to the owner's user manager, where Hyprland
  # runs, for the session's length.
  export AQ_DRM_DEVICES=$OMANYWHERE_CARD
  # Mesa's EGL in a Wayland client takes the compositor's render node; a card
  # with none (vkms) leaves it a null device and it crashes. Software GL then.
  for render in /dev/dri/renderD* ''; do
    [[ -n $render && -r $render && -w $render ]] && break
  done
  if [[ -z $render ]]; then
    export LIBGL_ALWAYS_SOFTWARE=1
    say "no render node the owner can open: LIBGL_ALWAYS_SOFTWARE=1, GL renders on the CPU"
  fi
  # Master may have changed hands since check (see the top of this file).
  guard_master "$OMANYWHERE_CARD" "$OMANYWHERE_CARD_KIND"
  say "starting Hyprland under uwsm on $OMANYWHERE_CARD ($OMANYWHERE_CARD_KIND, $OMANYWHERE_CARD_DRIVER)"
  # As Omarchy's session entry, /usr/share/wayland-sessions/hyprland-uwsm.desktop.
  exec uwsm start -e -D Hyprland hyprland.desktop
}

# Sourced (by tests/session-logic.sh), it only defines the functions.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  shopt -s nullglob
  case ${1:-} in
    check | prepare | start) "$1" ;;
    *)
      say "usage: $0 check|prepare|start"
      exit 2
      ;;
  esac
fi
